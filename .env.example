AWS_REGION=ca-central-1

# IAM user used by the consumer, queue processor and analysis scripts
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# IAM user used only by code/kvs/stream.sh to publish video to Kinesis Video Streams
KVS_PRODUCER_ACCESS_KEY_ID=your-producer-access-key-id
KVS_PRODUCER_SECRET_ACCESS_KEY=your-producer-secret-access-key

KVS_STREAM_NAME=your-kinesis-video-stream-name
S3_BUCKET_NAME=your-plate-crops-bucket
SQS_QUEUE_URL=https://sqs.your-region.amazonaws.com/123456789012/your-queue.fifo

HA_WEBHOOK_URL=https://your-home-assistant-host/api/webhook/your-webhook-id
